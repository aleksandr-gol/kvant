# ---------------------------------------------------------------------------
# Квант — переменные окружения. Скопируйте в .env и заполните.
# ---------------------------------------------------------------------------

# GigaChat (основная модель). Ключ авторизации из личного кабинета developers.sber.ru
# (строка Base64 «Authorization key»), не client secret.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Pro
# Модель для вспомогательных вызовов (сжатие контекста, чтение страниц); по умолчанию = GIGACHAT_MODEL
# GIGACHAT_FAST_MODEL=GigaChat-3-Pro
# GIGACHAT_API_URL=https://api.giga.chat/v1   (старый адрес gigachat.devices.sberbank.ru/api/v1 не знает GigaChat-3)
# Freemium разрешает мало одновременных запросов
GIGACHAT_MAX_CONCURRENCY=1
# Строка в журнал на каждый вызов модели (причина завершения, токены, время), без текста
GIGACHAT_LOG=1
# Сертификат Минцифры для TLS к GigaChat (лежит в репозитории)
NODE_EXTRA_CA_CERTS=certs/russian_trusted_root_ca.pem

# Данные рынка: MOEX ISS, Банк России, smart-lab, RSS — ключи не нужны.

# ---------------------------------------------------------------------------
# Веб-версия (bun run web)
# ---------------------------------------------------------------------------
PORT=8787
HOST=127.0.0.1
# WEB_MODEL=GigaChat-3-Pro
WEB_DAILY_LIMIT=300
WEB_SESSION_HOURLY_LIMIT=15
WEB_MAX_CONCURRENT_RUNS=2
WEB_MAX_ITERATIONS=20
# Предел времени на один ответ, мс
WEB_RUN_TIMEOUT_MS=420000

# ---------------------------------------------------------------------------
# Необязательно
# ---------------------------------------------------------------------------
# Веб-поиск (любой из поддерживаемых провайдеров)
# EXASEARCH_API_KEY=
# TAVILY_API_KEY=

# Другие модели тоже работают: gpt-*, claude-*, gemini-*, ollama:<model>
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
